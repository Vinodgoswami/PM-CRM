# Copy to .env and fill in. .env is gitignored; never commit real values.
NODE_ENV=development
DATABASE_URL=postgresql://salescrm:salescrm@localhost:5432/salescrm
TEST_DATABASE_URL=postgresql://salescrm:salescrm@localhost:5432/salescrm_test

PORT=4000
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
WEB_ORIGIN=http://localhost:5173
# true in production (HTTPS only)
COOKIE_SECURE=false
LOG_LEVEL=info
# Demo login password for `pnpm db:seed` (dev only; default salescrm-dev-only)
SEED_PASSWORD=

# Document storage (local disk in dev; S3-compatible bucket in production)
# Exchange rates (D-020): frankfurter (free ECB rates; only currency pair + date are sent), fixed (tests), off
FX_PROVIDER=frankfurter

# Email for invites and password resets (D-023). log = written to the API log, not sent (development);
# smtp = sent through any SMTP provider; off = never sent (links are shown to copy either way).
EMAIL_TRANSPORT=log
EMAIL_FROM=Project Management CRM <no-reply@yourcompany.com>
# SMTP, e.g. Google Workspace/Gmail: smtp.gmail.com, 465, SMTP_SECURE=true, an App Password (not your normal one);
# Zoho: smtp.zoho.in 465; Microsoft 365: smtp.office365.com 587; Amazon SES / SendGrid / Resend: their SMTP host + key.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

