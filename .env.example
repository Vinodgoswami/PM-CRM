# Copy to .env and fill in. .env is gitignored; never commit real values.
NODE_ENV=development
DATABASE_URL=postgresql://salescrm:salescrm@localhost:5432/salescrm
TEST_DATABASE_URL=postgresql://salescrm:salescrm@localhost:5432/salescrm_test

PORT=4000
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
WEB_ORIGIN=http://localhost:5173
# true in production (HTTPS only)
COOKIE_SECURE=false
LOG_LEVEL=info

# Document storage (local disk in dev; S3-compatible bucket in production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

