# Copy to .env and fill in. .env is gitignored; never commit real values.
NODE_ENV=development
DATABASE_URL=postgresql://salescrm:salescrm@localhost:5432/salescrm
TEST_DATABASE_URL=postgresql://salescrm:salescrm@localhost:5432/salescrm_test

# 32+ random characters each: openssl rand -base64 48
JWT_ACCESS_SECRET=
# 32 bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=

# Document storage (local disk in dev; S3-compatible bucket in production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web app
VITE_API_URL=http://localhost:4000
