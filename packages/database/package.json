{
  "name": "@salescrm/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "prisma generate",
    "migrate:dev": "node ../../scripts/with-env.mjs prisma migrate dev",
    "migrate:deploy": "node ../../scripts/with-env.mjs prisma migrate deploy",
    "migrate:create": "node ../../scripts/with-env.mjs prisma migrate dev --create-only",
    "reset": "node ../../scripts/with-env.mjs prisma migrate reset --force --skip-seed",
    "studio": "node ../../scripts/with-env.mjs prisma studio"
  },
  "devDependencies": {
    "@salescrm/eslint-config": "workspace:*",
    "@salescrm/typescript-config": "workspace:*",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "prisma": "6.19.3",
    "@types/node": "^24.19.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
