{
  "name": "@salescrm/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./permissions": {
      "source": "./src/permissions.ts",
      "types": "./dist/permissions.d.ts",
      "import": "./dist/permissions.js",
      "require": "./dist/permissions.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@salescrm/eslint-config": "workspace:*",
    "@salescrm/typescript-config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@salescrm/types": "workspace:*",
    "argon2": "^0.45.1"
  },
  "typesVersions": {
    "*": {
      "permissions": [
        "./dist/permissions.d.ts"
      ]
    }
  }
}
